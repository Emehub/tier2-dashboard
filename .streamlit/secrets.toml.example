# Copy this into Streamlit Cloud → your app → Settings → Secrets (do NOT upload a real secrets file to GitHub).

# ---- KoboToolbox: the six GH_T2 forms (the dashboard reads Kobo directly) ----
# Kobo → your name (top right) → Account settings → Security → API key → Display → copy.
KOBO_TOKEN = "PASTE_KOBO_API_KEY_HERE"
KOBO_SERVER = "https://kf.kobotoolbox.org"

# Each project's ID is in its web address:  kf.kobotoolbox.org/#/forms/  THIS_PART  /summary
# To move from the DEV (test) projects to the production projects later, change only these six lines.
[KOBO_FORMS]
attendance = "PASTE_ID_OF_GH_T2_01_Event_Attendance"
screening  = "PASTE_ID_OF_GH_T2_02_Screening_Recruitment"
baseline   = "PASTE_ID_OF_GH_T2_03_Baseline_v4"
contact    = "PASTE_ID_OF_GH_T2_04_Cohort_Contact"
qa         = "PASTE_ID_OF_GH_T2_05_Supervisor_QA"
backcheck  = "PASTE_ID_OF_GH_T2_06_Backcheck"
feedback   = "PASTE_ID_OF_THE_GT2_FEEDBACK_LOG_FORM"   # optional: keeps the Feedback page

# ---- Google Sheet (optional) ----
# Only needed for the team-maintained tabs (config_sentinels, config_actions, config_readiness, config_settings).
# Without KOBO_TOKEN above, the dashboard falls back to reading the older four forms from this Sheet.
SHEET_ID = "PASTE_SHEET_ID_HERE"

# Open the service-account key file (.json) in Notepad, copy EVERYTHING, and paste it between the triple quotes.
GCP_SERVICE_ACCOUNT_JSON = '''
PASTE_THE_WHOLE_JSON_FILE_HERE
'''
